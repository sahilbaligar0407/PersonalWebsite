# SmartCal — calendar service env (Railway). No client-side secrets anymore.

# Postgres (Railway provides this — reference the Postgres plugin variable).
DATABASE_URL=postgresql://user:password@host:5432/railway

# Secret used to sign auth JWTs. Generate a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Self-hosted SLM (Ollama) service — reach it over Railway private networking.
SLM_BASE_URL=http://smartcal-slm.railway.internal:11434
SLM_MODEL=qwen2.5:3b-instruct

# Base path the app is served under. The Docker image sets this to /Calendar;
# leave empty for local dev (app served at the root).
# APP_BASE_PATH=/Calendar

# Local dev only: run the API server on this port (the Vite dev server proxies
# /api here). See package.json "dev:server".
# PORT=8787

# Abort a parse that hangs (ms).
# SLM_TIMEOUT_MS=120000
